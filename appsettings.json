{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "MetricsOptions": {
    "RefreshIntervalSeconds": 5,
    "EnableSimulationMode": false,
    "CpuThresholdWarningPercentage": 80.0
  },
  "AllowedHosts": "*"
}
